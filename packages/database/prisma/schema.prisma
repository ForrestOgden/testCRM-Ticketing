generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientLifecycleStatus {
  LEAD
  PROSPECT
  QUALIFIED
  PROPOSAL
  ONBOARDING
  ACTIVE
  AT_RISK
  INACTIVE
  FORMER
}

enum TicketStatus {
  NEW
  TRIAGE
  ASSIGNED
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_VENDOR
  SCHEDULED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  P1_CRITICAL
  P2_HIGH
  P3_NORMAL
  P4_LOW
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  PROBLEM
  QUESTION
  ALERT
}

enum TicketEntryKind {
  CUSTOMER_MESSAGE
  TECHNICIAN_MESSAGE
  INTERNAL_NOTE
  SYSTEM_EVENT
}

enum ActivityKind {
  TASK
  CALL
  MEETING
  EMAIL
  NOTE
  REMINDER
  FOLLOW_UP
}

enum ExternalProvider {
  DATTO_RMM
  MICROSOFT_GRAPH
  AUTOTASK
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  entraObjectId    String   @unique
  email            String   @unique
  displayName      String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  ticketAssignments Ticket[] @relation("TicketAssignee")
  accountClients   Client[] @relation("ClientAccountOwner")
  technicalClients Client[] @relation("ClientTechnicalOwner")
  auditEvents      AuditEvent[]
  roleAssignments  UserRole[]
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Client {
  id                String                @id @default(uuid()) @db.Uuid
  name              String
  dbaName           String?
  lifecycleStatus   ClientLifecycleStatus @default(PROSPECT)
  industry          String?
  employeeCount     Int?
  clientSince       DateTime?
  website           String?
  primaryDomain     String?
  mainPhone         String?
  generalEmail      String?
  relationshipHealth Int?
  internalNotes     String?
  accountOwnerId    String?               @db.Uuid
  technicalOwnerId  String?               @db.Uuid
  accountOwner      User?                 @relation("ClientAccountOwner", fields: [accountOwnerId], references: [id], onDelete: SetNull)
  technicalOwner    User?                 @relation("ClientTechnicalOwner", fields: [technicalOwnerId], references: [id], onDelete: SetNull)
  contacts          Contact[]
  locations         Location[]
  devices           Device[]
  tickets           Ticket[]
  opportunities     Opportunity[]
  activities        Activity[]
  technicalProfile  TechnicalProfileItem[]
  tags              ClientTag[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  archivedAt        DateTime?

  @@index([name])
  @@index([lifecycleStatus])
  @@index([primaryDomain])
}

model Contact {
  id                     String   @id @default(uuid()) @db.Uuid
  clientId               String   @db.Uuid
  locationId             String?  @db.Uuid
  firstName              String
  lastName               String
  title                  String?
  department             String?
  email                  String?
  alternateEmail         String?
  officePhone            String?
  mobilePhone            String?
  preferredCommunication String?
  isDecisionMaker        Boolean  @default(false)
  isTechnicalContact     Boolean  @default(false)
  isBillingContact       Boolean  @default(false)
  isVip                  Boolean  @default(false)
  isInactive             Boolean  @default(false)
  notes                  String?
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location               Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tickets                Ticket[]
  opportunities          OpportunityContact[]
  activities             Activity[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([clientId, lastName, firstName])
  @@index([email])
}

model Location {
  id          String  @id @default(uuid()) @db.Uuid
  clientId    String  @db.Uuid
  name        String
  address1    String?
  address2    String?
  city        String?
  region      String?
  postalCode  String?
  countryCode String? @db.Char(2)
  phone       String?
  isPrimary   Boolean @default(false)
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  devices     Device[]
  tickets     Ticket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Device {
  id               String   @id @default(uuid()) @db.Uuid
  clientId         String   @db.Uuid
  locationId       String?  @db.Uuid
  hostname         String
  description      String?
  deviceClass      String?
  manufacturer     String?
  model            String?
  serialNumber     String?
  operatingSystem  String?
  osVersion        String?
  lastLoggedInUser String?
  internalIp       String?
  externalIp       String?
  macAddress       String?
  lastSeenAt       DateTime?
  isOnline         Boolean?
  warrantyEndsAt   DateTime?
  patchStatus      String?
  openAlertCount   Int      @default(0)
  lastSyncedAt     DateTime?
  syncStatus       String?
  syncError        String?
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location         Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tickets          Ticket[]
  rmmAlerts        RmmAlert[]
  externalMappings ExternalRecordMapping[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  retiredAt        DateTime?

  @@index([clientId, hostname])
  @@index([serialNumber])
  @@index([lastLoggedInUser])
}

model TicketQueue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true)
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id                 String         @id @default(uuid()) @db.Uuid
  number             BigInt         @unique @default(autoincrement())
  subject            String
  description        String
  clientId           String         @db.Uuid
  contactId          String?        @db.Uuid
  locationId         String?        @db.Uuid
  deviceId           String?        @db.Uuid
  assigneeId         String?        @db.Uuid
  queueId            String?        @db.Uuid
  status             TicketStatus   @default(NEW)
  priority           TicketPriority @default(P3_NORMAL)
  type               TicketType     @default(INCIDENT)
  category           String?
  subcategory        String?
  source             String
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  dueAt              DateTime?
  client             Client         @relation(fields: [clientId], references: [id])
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  location           Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  device             Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  assignee           User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  queue              TicketQueue?   @relation(fields: [queueId], references: [id], onDelete: SetNull)
  entries            TicketEntry[]
  attachments        Attachment[]
  rmmAlerts          RmmAlert[]
  emailThreads       EmailThread[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([clientId, status])
  @@index([assigneeId, status])
  @@index([queueId, status])
  @@index([priority, status])
  @@index([createdAt])
}

model TicketEntry {
  id         String          @id @default(uuid()) @db.Uuid
  ticketId   String          @db.Uuid
  authorId   String?         @db.Uuid
  kind       TicketEntryKind
  bodyText   String
  bodyHtml   String?
  ticket     Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([ticketId, createdAt])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String?  @db.Uuid
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  sha256       String
  uploadedById String?  @db.Uuid
  ticket       Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([sha256])
}

model EmailThread {
  id                     String   @id @default(uuid()) @db.Uuid
  ticketId               String   @db.Uuid
  provider               ExternalProvider @default(MICROSOFT_GRAPH)
  providerConversationId String?
  ticket                 Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messages               EmailMessage[]
  createdAt              DateTime @default(now())

  @@index([ticketId])
  @@index([providerConversationId])
}

model EmailMessage {
  id                    String   @id @default(uuid()) @db.Uuid
  emailThreadId         String   @db.Uuid
  providerMessageId     String   @unique
  internetMessageId     String?  @unique
  inReplyTo             String?
  referenceHeader       String?
  fromAddress           String
  toAddresses           Json
  ccAddresses           Json?
  subject               String
  receivedAt            DateTime?
  sentAt                DateTime?
  processingDisposition String?
  emailThread           EmailThread @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([emailThreadId, createdAt])
}

model RmmAlert {
  id               String   @id @default(uuid()) @db.Uuid
  deviceId         String   @db.Uuid
  ticketId         String?  @db.Uuid
  provider         ExternalProvider @default(DATTO_RMM)
  remoteUid        String
  alertType        String?
  category         String?
  message          String?
  raisedAt         DateTime?
  resolvedAt       DateTime?
  isOpen           Boolean  @default(true)
  rawPayload       Json?
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ticket           Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, remoteUid])
  @@index([deviceId, isOpen])
}

model ExternalRecordMapping {
  id           String   @id @default(uuid()) @db.Uuid
  provider     ExternalProvider
  entityType   String
  entityId     String   @db.Uuid
  remoteUid    String
  deviceId     String?  @db.Uuid
  remoteHash   String?
  lastSyncedAt DateTime?
  syncError    String?
  device       Device?  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, entityType, remoteUid])
  @@index([entityId])
}

model TechnicalProfileItem {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  key       String
  label     String
  value     String?
  secureUrl String?
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, key])
}

model Opportunity {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @db.Uuid
  name            String
  ownerId         String?  @db.Uuid
  valueCents      BigInt?
  probability     Int?
  pipeline        String
  stage           String
  expectedCloseAt DateTime?
  notes           String?
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts        OpportunityContact[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId, stage])
}

model OpportunityContact {
  opportunityId String @db.Uuid
  contactId     String @db.Uuid
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  contact       Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@id([opportunityId, contactId])
}

model Activity {
  id            String       @id @default(uuid()) @db.Uuid
  kind          ActivityKind
  title         String
  body          String?
  clientId      String?      @db.Uuid
  contactId     String?      @db.Uuid
  opportunityId String?      @db.Uuid
  ticketId      String?      @db.Uuid
  ownerId       String?      @db.Uuid
  dueAt         DateTime?
  completedAt   DateTime?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clientId, createdAt])
  @@index([contactId, createdAt])
  @@index([dueAt])
}

model Tag {
  id      String @id @default(uuid()) @db.Uuid
  name    String @unique
  color   String?
  clients ClientTag[]
}

model ClientTag {
  clientId String @db.Uuid
  tagId    String @db.Uuid
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([clientId, tagId])
}

model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.Uuid
  action     String
  objectType String
  objectId   String
  oldValue   Json?
  newValue   Json?
  sourceIp   String?
  requestId  String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([objectType, objectId, createdAt])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String
  aggregateType String
  aggregateId String
  payload     Json
  occurredAt  DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?

  @@index([processedAt, occurredAt])
}

model BackgroundJob {
  id          String    @id @default(uuid()) @db.Uuid
  queue       String
  name        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAfter    DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(10)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue, status, runAfter])
}
