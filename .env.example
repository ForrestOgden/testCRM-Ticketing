# Core
NODE_ENV=development
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://msp_crm:change-me-local@localhost:5432/msp_crm
PORT=3001
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001/api

# Encrypts integration credentials stored in PostgreSQL.
# Use exactly 32 random bytes encoded as base64, or 64 hexadecimal characters.
# Example generator: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Authentication
# development = local admin identity; entra = Microsoft Entra ID bearer validation
AUTH_MODE=development
DEV_USER_EMAIL=admin@mspcrm.local
DEV_USER_NAME=Local Administrator
DEV_USER_OID=00000000-0000-0000-0000-000000000001
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_API_SCOPE=
NEXT_PUBLIC_AUTH_MODE=development

# Browser -> API
NEXT_PUBLIC_API_URL=http://localhost:3001/api
INTERNAL_API_URL=http://api:3001/api

# Database pool
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# API controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REQUESTS=240

# Worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_STALE_LOCK_MINUTES=15
DATTO_SYNC_MINUTES=15
GRAPH_POLL_MINUTES=5

# Seed
SEED_SAMPLE_DATA=true

# Datto RMM bootstrap/fallback values.
# Production credentials can instead be entered in Settings > Integrations and are encrypted at rest.
DATTO_API_URL=
DATTO_API_KEY=
DATTO_API_SECRET=
DATTO_WEBHOOK_SECRET=
DATTO_WEB_URL=
DATTO_AUTO_CREATE_CLIENTS=false

# Microsoft Graph bootstrap/fallback values.
# Settings > Integrations is the preferred production configuration path.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SUPPORT_MAILBOX=
GRAPH_UNMATCHED_CLIENT_ID=
GRAPH_WEBHOOK_URL=
GRAPH_WEBHOOK_CLIENT_STATE=

# Endpoint launcher
ENDPOINT_ENROLLMENT_BOOTSTRAP_SECRET=

# Public hostname used by Caddy in production
APP_DOMAIN=crm.example.com
