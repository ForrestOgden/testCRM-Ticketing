# Core
NODE_ENV=development
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://msp_crm:change-me-local@localhost:5432/msp_crm
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Authentication
# development = local admin identity; entra = Microsoft Entra ID bearer validation
AUTH_MODE=development
DEV_USER_EMAIL=admin@mspcrm.local
DEV_USER_NAME=Local Administrator
DEV_USER_OID=00000000-0000-0000-0000-000000000001
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_API_SCOPE=
NEXT_PUBLIC_AUTH_MODE=development

# Browser -> API
NEXT_PUBLIC_API_URL=http://localhost:3001/api
INTERNAL_API_URL=http://api:3001/api

# Database pool
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# API controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_REQUESTS=240

# Seed
SEED_SAMPLE_DATA=true

# Datto RMM - configure before enabling the integration
DATTO_API_URL=
DATTO_API_KEY=
DATTO_API_SECRET=
DATTO_WEBHOOK_SECRET=

# Microsoft Graph - configure before enabling email ticketing
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SUPPORT_MAILBOX=
GRAPH_WEBHOOK_SECRET=

# Endpoint launcher
ENDPOINT_ENROLLMENT_BOOTSTRAP_SECRET=

# Public hostname used by Caddy in production
APP_DOMAIN=crm.example.com
