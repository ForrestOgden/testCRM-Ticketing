{
  "name": "msp-crm",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @msp-crm/web dev",
    "dev:api": "pnpm --filter @msp-crm/api start:dev",
    "dev:worker": "pnpm --filter @msp-crm/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @msp-crm/database generate",
    "db:validate": "pnpm --filter @msp-crm/database validate",
    "db:migrate": "pnpm --filter @msp-crm/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @msp-crm/database migrate:deploy",
    "db:seed": "pnpm --filter @msp-crm/database seed",
    "ci": "pnpm db:generate && pnpm db:validate && pnpm typecheck && pnpm build"
  }
}
